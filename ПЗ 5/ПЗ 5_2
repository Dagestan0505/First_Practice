"Описать функцию PowerA234(A), вычисляющую вторую, третью и четвертую степень числа А. С помощью этой функции найти степени для пяти данных чисел."
def PowerA234(A):
    """
    Вычисляет 2-ю, 3-ю и 4-ю степень числа A.
    Возвращает три значения: B (квадрат), C (куб), D (4-я степень).
    """
    B = A * A
    C = A * B
    D = A * C
    return B, C, D


print("--- Задача 2: Степени чисел ---")

count = 1
while count <= 5:
    try:
        line = input(f"Введите {count}-е число (A): ")
        num_a = float(line)
        
        sqr, cube, power4 = PowerA234(num_a)
        
        print(f"Для числа {num_a}:")
        print(f"  Вторая степень: {sqr}")
        print(f"  Третья степень: {cube}")
        print(f"  Четвертая степень: {power4}")
        print("-" * 20)
        
        count += 1
    except ValueError:
        print("Ошибка! Введено некорректное число.")

print("Программа завершена.")
