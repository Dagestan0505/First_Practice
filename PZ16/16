class Figura:
    # базовый класс фигура
    def ploshad(self):
        # этот метод будут переопределять наследники
        pass


class Kvadrat(Figura):
    # класс квадрат наследуется от фигуры
    def __init__(self, storona):
        self.storona = storona  # сторона квадрата

    def ploshad(self):
        # площадь квадрата сторона в квадрате
        return self.storona ** 2

    def perimetr(self):
        return 4 * self.storona


class Pryamougolnik(Figura):
    # класс прямоугольник наследуется от фигуры
    def __init__(self,ширина, vysota):
        self.shirina =ширина
        self.vysota = vysota

    def ploshad(self):
        # площадь прямоугольника это ширина умножить на высоту
        return self.shirina * self.vysota

    def perimetr(self):
        return 2 * (self.shirina + self.vysota)


