''Создайте класс «Круг», который имеет атрибут радиуса и методы вычисления площади, длины окружности и диаметра.''


import math



class Krug:
    # класс для работы с кругом
    def __init__(self, radius):
        self.radius = radius  # радиус

    def ploshhad(self):
        # площадь круга = пи * р в квадрате
        return math.pi * self.radius ** 2

    def dlina_okruzhnosti(self):
        # длина окружности = 2 * пи * р
        return 2 * math.pi * self.radius

    def diametr(self):
        # диаметр это радиус умноженный на 2
        return self.radius * 2


print("=== Класс Круг ===")

k1 = Krug(5)
print(f"Радиус: {k1.radius}")
print(f"Площадь: {k1.ploshhad():.2f}")
print(f"Длина окружности: {k1.dlina_okruzhnosti():.2f}")
print(f"Диаметр: {k1.diametr()}")

print()

