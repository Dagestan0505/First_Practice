''Из текстового файла (writer.txt) выбрать фамилии писателей, посчитать количество 
фамилий. Создать новый файл, в котором выполнить замену слова «роман» на слово 
«произведение». ''

import re

файл = open("writer.txt", "r", encoding="utf-8")
текст = файл.read()
файл.close()

фамилии = re.findall(r"[А-Я][а-я]+", текст)

print("--- Список фамилий ---")
for фамилия in фамилии:
    print(фамилия)

print()
print("Количество фамилий:", len(фамилии))

новый_текст = re.sub(r"роман", "произведение", текст)

файл_новый = open("new_writer.txt", "w", encoding="utf-8")
файл_новый.write(новый_текст)
файл_новый.close()

print()
print("Замена выполнена. Новый файл new_writer.txt успешно создан.")
