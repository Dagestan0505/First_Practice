        ("Молоко 3.2%", "Магнит", 100, 150, "литр", 65.0),
        ("Хлеб белый", "Пятерочка", 200, 180, "шт", 35.5),
        ("Сахар", "Магнит", 50, 80, "кг", 72.0),
        ("Масло подсолн.", "Ашан", 60, 40, "литр", 120.0),
        ("Гречка", "Пятерочка", 90, 95, "кг", 85.0),
