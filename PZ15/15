        ("Кефир 2.5%", "Магнит", 120, 130, "литр", 58.0),
        ("Сыр Российский", "Ашан", 30, 25, "кг", 450.0),
        ("Колбаса вар.", "Лента", 40, 35, "кг", 320.0),
        ("Яйцо С1", "Пятерочка", 500, 480, "шт", 9.5),
    ]
    conn = connect_db()
