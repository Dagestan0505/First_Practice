'' Приложение ОПТОВАЯ БАЗА для автоматизированного контроля движения товаров на оптовой базе. Таблица Товары должна содержать следующие данные: Код товара, Наименование товара, Наименование магазина, Заявки магазина, Количество товара на складе, Единицы измерения, Оптовая цена ''


import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3


def connect_db():
    conn = sqlite3.connect("optovaya_baza.db")
    cur = conn.cursor()
    # создаем таблицу если её нет
    cur.execute("""
        CREATE TABLE IF NOT EXISTS tovary (
            kod INTEGER PRIMARY KEY AUTOINCREMENT,
            nazvanie TEXT,
            magazin TEXT,
            zayavka INTEGER,
            kolichestvo INTEGER,
            ed_izm TEXT,
            cena REAL
        )
    """)
    conn.commit()
    return conn


def load_data():
    conn = connect_db()
    cur = conn.cursor()
    cur.execute("SELECT * FROM tovary")
    rows = cur.fetchall()
    conn.close()
    # очищаем таблицу перед загрузкой
    for row in tree.get_children():
        tree.delete(row)
    for row in rows:
        tree.insert("", tk.END, values=row)


def add_record():
    nazvanie = entry_name.get()
    magazin = entry_mag.get()
    zayavka = entry_zayavka.get()
    kol = entry_kol.get()
    ed = entry_ed.get()
    cena = entry_cena.get()
    
    if not all([nazvanie, magazin, zayavka, kol, ed, cena]):
        messagebox.showwarning("Ошибка", "Заполните все поля!")
        return

    try:
        conn = connect_db()
        cur = conn.cursor()
        cur.execute(
            "INSERT INTO tovary (nazvanie, magazin, zayavka, kolichestvo, ed_izm, cena)"
            " VALUES (?, ?, ?, ?, ?, ?)",
            (nazvanie, magazin, int(zayavka), int(kol), ed, float(cena))
        )
        conn.commit()
        conn.close()
        load_data()
        clear_fields()
        messagebox.showinfo("OK", "Запись добавлена!")
    except ValueError:
        messagebox.showerror("Ошибка", "Проверьте числовые поля!")


def delete_by_kod():
    val = entry_search.get()
    if not val:
        messagebox.showwarning("Ошибка", "Введите код товара!")
        return
    try:
        conn = connect_db()
        cur = conn.cursor()
        cur.execute("DELETE FROM tovary WHERE kod = ?", (int(val),))
        conn.commit()
        conn.close()
        load_data()
        messagebox.showinfo("OK", f"Товар с кодом {val} удален!")
    except ValueError:
        messagebox.showerror("Ошибка", "Код должен быть числом!")


def delete_by_magazin():
    val = entry_search.get()
    if not val:
        messagebox.showwarning("Ошибка", "Введите название магазина!")
        return
    conn = connect_db()
    cur = conn.cursor()
    cur.execute("DELETE FROM tovary WHERE magazin = ?", (val,))
    conn.commit()
    conn.close()
    load_data()
    messagebox.showinfo("OK", f"Записи магазина '{val}' удалены!")


def delete_deficit():
    conn = connect_db()
    cur = conn.cursor()
    cur.execute("DELETE FROM tovary WHERE kolichestvo < zayavka")
    conn.commit()
    conn.close()
    load_data()
    messagebox.showinfo("OK", "Дефицитные товары удалены!")


def search_by_name():
    val = entry_search.get()
    if not val:
        messagebox.showwarning("Ошибка", "Введите название товара!")
        return
    conn = connect_db()
    cur = conn.cursor()
    cur.execute("SELECT * FROM tovary WHERE nazvanie LIKE ?", (f"%{val}%",))
    rows = cur.fetchall()
    conn.close()
    for row in tree.get_children():
        tree.delete(row)
    for row in rows:
        tree.insert("", tk.END, values=row)


def search_by_mag():
