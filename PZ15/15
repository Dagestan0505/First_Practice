        return
    conn = connect_db()
    cur = conn.cursor()
    cur.execute("SELECT * FROM tovary WHERE magazin = ?", (val,))
    rows = cur.fetchall()
    conn.close()
    for row in tree.get_children():
        tree.delete(row)
    for row in rows:
        tree.insert("", tk.END, values=row)


def search_by_price():
    val = entry_search.get()
    if not val:
        messagebox.showwarning("Ошибка", "Введите максимальную цену!")
        return
    try:
        conn = connect_db()
        cur = conn.cursor()
        cur.execute("SELECT * FROM tovary WHERE cena < ?", (float(val),))
        rows = cur.fetchall()
        conn.close()
        for row in tree.get_children():
            tree.delete(row)
        for row in rows:
            tree.insert("", tk.END, values=row)
    except ValueError:
        messagebox.showerror("Ошибка", "Введите число!")


def edit_price():
    kod = entry_search.get()
    new_val = entry_edit.get()
    if not kod or not new_val:
        messagebox.showwarning("Ошибка", "Заполните поля поиска и редактирования!")
        return
    try:
        conn = connect_db()
        cur = conn.cursor()
        cur.execute("UPDATE tovary SET cena = ? WHERE kod = ?",
                    (float(new_val), int(kod)))
        conn.commit()
        conn.close()
        load_data()
        messagebox.showinfo("OK", "Цена обновлена!")
    except ValueError:
        messagebox.showerror("Ошибка", "Проверьте данные!")


