''' Известно, что X кг конфет стоит A рублей. Определить, сколько стоит 1 кг и Y кг этих же конфет. '''

try:
    x = float(input("Введите сколько кг конфет (X): "))
    a = float(input("Введите цену за эти конфеты (A): "))
    y = float(input("Введите сколько кг нужно посчитать (Y): "))

    price_one = a / x
    price_y = price_one * y

    print("Цена 1 кг конфет:", price_one)
    print("Цена", y, "кг конфет:", price_y)

except:
    print("Ошибка! Введите числа правильно.")

