'''Даны координаты точки, не лежащей на координатных осях OX и OY. Определить номер координатной четверти, в которой находится данная точка.'''

x = input("Введите координату x: ")
y = input("Введите координату y: ")

while type(x) != float:
    try:
        x = float(x)
    except ValueError:
        print("Ошибка! Введите число.")
        x = input("Введите координату x: ")

while type(y) != float:
    try:
        y = float(y)
    except ValueError:
        print("Ошибка! Введите число.")
        y = input("Введите координату y: ")

if x > 0 and y > 0:
    print("Точка находится в 1 четверти")
elif x < 0 and y > 0:
    print("Точка находится во 2 четверти")
elif x < 0 and y < 0:
    print("Точка находится в 3 четверти")
elif x > 0 and y < 0:
    print("Точка находится в 4 четверти")
else:
    print("Точка лежит на оси, по условию так быть не должно")
