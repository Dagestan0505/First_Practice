''Организовать и вывести последовательность А из n чисел. Из 
последовательности А получить две последовательности В и С: в последовательности В – 
четные элементы А, С – нечетные элементы А. Произвести суммирование 
соответствующих элементов последовательностей В и С. Найти минимальный элемент 
полученной последовательности.''

class Plant:
    def __init__(self, name, color, age):
        self.name = name
        self.color = color
        self.age = age

    def show_info(self):
        print(f"Растение: {self.name}, Цвет: {self.color}, Возраст: {self.age} лет")

    def change_age(self, new_age):
        self.age = new_age
        print(f"Возраст обновлен на: {self.age}")

plant1 = Plant("Роза", "Красный", 2)
plant1.show_info()
plant1.change_age(3)
plant1.show_info()

print("-" * 30)
