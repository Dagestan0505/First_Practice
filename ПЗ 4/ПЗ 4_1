'''Даны целые числа A и B (A < B). Вывести в порядке возрастания все целые числа, расположенные между A и B (включая сами числа A и B), и количество N этих чисел.'''

a = input("Введите число A: ")
b = input("Введите число B: ")

while type(a) != int:
    try:
        a = int(a)
    except ValueError:
        print("Ошибка, введите целое число")
        a = input("Введите число A: ")

while type(b) != int:
    try:
        b = int(b)
    except ValueError:
        print("Ошибка, введите целое число")
        b = input("Введите число B: ")

count = 0

while a <= b:
    print(a)
    count += 1
    a += 1

print("Количество чисел:", count)

