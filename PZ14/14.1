его в IDE PyCharm Community с применением пакета tk. Получить интерфейс максимально
приближенный к оригиналу (см. таблицу 1) ''


import tkinter as tk
from tkinter import messagebox


def register():
    name = entry_name.get()
    email = entry_email.get()
    password = entry_pass.get()
    confirm = entry_confirm.get()

    if name == "" or email == "" or password == "" or confirm == "":
        messagebox.showwarning("Ошибка", "Заполните все поля!")
        return

    if password != confirm:
        messagebox.showwarning("Ошибка", "Пароли не совпадают!")
        return

    messagebox.showinfo("Успех", "Регистрация прошла успешно!")


root = tk.Tk()
root.title("Register")
root.geometry("400x520")
root.resizable(False, False)
root.configure(bg="#f2f2f2")


title_label = tk.Label(root, text="Create an Account",
                       font=("Arial", 18, "bold"), bg="#f2f2f2", fg="#333333")
title_label.pack(pady=(30, 5))

sub_label = tk.Label(root, text="Fill in the form below to get instant access.",
                     font=("Arial", 9), bg="#f2f2f2", fg="#888888")
sub_label.pack(pady=(0, 20))

frame = tk.Frame(root, bg="#f2f2f2")
frame.pack(padx=40, fill="x")


def make_field(parent, label_text, show=None):
    lbl = tk.Label(parent, text=label_text, font=("Arial", 9, "bold"),
                   bg="#f2f2f2", fg="#555555", anchor="w")
    lbl.pack(fill="x", pady=(10, 2))
    entry = tk.Entry(parent, font=("Arial", 11), bd=0,
                     highlightthickness=1, highlightbackground="#cccccc",
                     highlightcolor="#4a90d9", relief="flat", show=show)
    entry.pack(fill="x", ipady=7)
    return entry


entry_name = make_field(frame, "Full Name")
entry_email = make_field(frame, "Email Address")
entry_pass = make_field(frame, "Password", show="*")
entry_confirm = make_field(frame, "Confirm Password", show="*")

agree_var = tk.BooleanVar()
chk = tk.Checkbutton(frame, text="I agree to the Terms and Conditions",
                     variable=agree_var, bg="#f2f2f2",
                     font=("Arial", 9), fg="#555555",
                     activebackground="#f2f2f2")
chk.pack(anchor="w", pady=(15, 0))

btn = tk.Button(root, text="Register Now", font=("Arial", 11, "bold"),
                bg="#4a90d9", fg="white", relief="flat",
                activebackground="#357abd", activeforeground="white",
                cursor="hand2", command=register)
btn.pack(padx=40, fill="x", pady=(20, 0), ipady=10)

login_label = tk.Label(root, text="Already have an account? Sign In",
                       font=("Arial", 9), bg="#f2f2f2", fg="#4a90d9",
                       cursor="hand2")
login_label.pack(pady=(12, 0))

root.mainloop()
