'' Разработать программу с применением пакета қ взяв в качестве условия однулюбую задачу из ПЗ №№ 1 - 9. ''

import tkinter as tk
from tkinter import messagebox


def summa_cifr(n):
    s = 0
    while n > 0:
        s += n % 10
        n //= 10
    return s


def skolko_shagov(n):
    count = 0
    while n != 0:
        n = n - summa_cifr(n)
        count += 1
    return count


def power_a234(a):
    b = a ** 2
    c = a ** 3
    d = a ** 4
    return b, c, d


def run_task1():
    try:
        n = int(entry_t1.get())
        if n <= 0:
            messagebox.showwarning("Ошибка", "Введите положительное целое число!")
            return
        result = skolko_shagov(n)
        label_res1.config(text=f"Количество шагов: {result}")
    except ValueError:
        messagebox.showerror("Ошибка", "Введите целое число!")


def run_task2():
    results = ""
    # берем 5 чисел из полей
    entries = [e2_1, e2_2, e2_3, e2_4, e2_5]
    for i, e in enumerate(entries):
        try:
            a = float(e.get())
            b, c, d = power_a234(a)
            results += f"A={a}: A²={b}, A³={c}, A⁴={d}\n"
        except ValueError:
            messagebox.showerror("Ошибка", f"Поле {i + 1} заполнено неправильно!")
            return
    text_res2.config(state="normal")
    text_res2.delete(1.0, tk.END)
    text_res2.insert(tk.END, results)
    text_res2.config(state="disabled")


root = tk.Tk()
root.title("ПЗ №14 — Вариант 1 / ПЗ №5")
root.geometry("460x580")
root.resizable(False, False)
root.configure(bg="#f5f5f5")

tk.Label(root, text="Задание 2 (ПЗ №5, Вариант 1)",
         font=("Arial", 14, "bold"), bg="#f5f5f5").pack(pady=(15, 5))


frame1 = tk.LabelFrame(root, text="Задача 1 — вычитание суммы цифр",
                        font=("Arial", 10, "bold"), bg="#f5f5f5", padx=10, pady=10)
frame1.pack(padx=20, fill="x", pady=5)

tk.Label(frame1, text="Введите число:", font=("Arial", 10),
         bg="#f5f5f5").pack(anchor="w")
entry_t1 = tk.Entry(frame1, font=("Arial", 11), bd=0,
                    highlightthickness=1, highlightbackground="#cccccc",
                    highlightcolor="#4a90d9", relief="flat")
entry_t1.pack(fill="x", ipady=5, pady=(2, 8))

tk.Button(frame1, text="Вычислить", font=("Arial", 10, "bold"),
          bg="#4a90d9", fg="white", relief="flat",
          activebackground="#357abd", cursor="hand2",
          command=run_task1).pack(fill="x", ipady=7)

label_res1 = tk.Label(frame1, text="Количество шагов: —",
                      font=("Arial", 11), bg="#f5f5f5", fg="#333333")
label_res1.pack(pady=(8, 0))

frame2 = tk.LabelFrame(root, text="Задача 2 — степени 5 чисел (A², A³, A⁴)",
                        font=("Arial", 10, "bold"), bg="#f5f5f5", padx=10, pady=10)
frame2.pack(padx=20, fill="x", pady=10)

tk.Label(frame2, text="Введите 5 чисел:", font=("Arial", 10),
         bg="#f5f5f5").pack(anchor="w")

nums_frame = tk.Frame(frame2, bg="#f5f5f5")
nums_frame.pack(fill="x", pady=(4, 8))

e2_1 = tk.Entry(nums_frame, font=("Arial", 11), width=7, bd=0,
                highlightthickness=1, highlightbackground="#cccccc",
                highlightcolor="#4a90d9", relief="flat")
e2_2 = tk.Entry(nums_frame, font=("Arial", 11), width=7, bd=0,
                highlightthickness=1, highlightbackground="#cccccc",
                highlightcolor="#4a90d9", relief="flat")
e2_3 = tk.Entry(nums_frame, font=("Arial", 11), width=7, bd=0,
                highlightthickness=1, highlightbackground="#cccccc",
                highlightcolor="#4a90d9", relief="flat")
e2_4 = tk.Entry(nums_frame, font=("Arial", 11), width=7, bd=0,
                highlightthickness=1, highlightbackground="#cccccc",
                highlightcolor="#4a90d9", relief="flat")
e2_5 = tk.Entry(nums_frame, font=("Arial", 11), width=7, bd=0,
                highlightthickness=1, highlightbackground="#cccccc",
                highlightcolor="#4a90d9", relief="flat")

for e in [e2_1, e2_2, e2_3, e2_4, e2_5]:
    e.pack(side="left", ipady=5, padx=3)

tk.Button(frame2, text="Вычислить степени", font=("Arial", 10, "bold"),
          bg="#4a90d9", fg="white", relief="flat",
          activebackground="#357abd", cursor="hand2",
          command=run_task2).pack(fill="x", ipady=7)

text_res2 = tk.Text(frame2, font=("Arial", 10), height=6,
                    state="disabled", bg="#eeeeee", relief="flat", bd=0)
text_res2.pack(fill="x", pady=(8, 0))

root.mainloop()
